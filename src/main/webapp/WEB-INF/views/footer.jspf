<%@ page contentType="text/html;charset=UTF-8" language="java" %>
</main>

<footer class="mt-20 bg-ink-900 text-slate-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 grid sm:grid-cols-2 md:grid-cols-4 gap-8">

    <!-- Brand -->
    <div>
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-btn">
          <i class="bi bi-car-front-fill"></i>
        </span>
        <span class="text-xl font-extrabold text-white">Drive<span class="text-brand-400">Lanka</span></span>
      </div>
      <p class="text-sm text-slate-400 leading-relaxed">Sri Lanka's modern vehicle rental platform. Cars, Bikes and Vans — on demand, island-wide.</p>
      <div class="flex items-center gap-3 mt-4 text-slate-500 text-xs">
        <span class="flex items-center gap-1"><i class="bi bi-car-front text-brand-500"></i> Cars</span>
        <span class="flex items-center gap-1"><i class="bi bi-bicycle text-indigo-400"></i> Bikes</span>
        <span class="flex items-center gap-1"><i class="bi bi-truck text-emerald-400"></i> Vans</span>
      </div>
    </div>

    <!-- Explore -->
    <div>
      <h4 class="text-white font-bold mb-3 text-sm uppercase tracking-wider">Explore</h4>
      <ul class="space-y-2.5 text-sm">
        <li><a class="hover:text-brand-400 transition flex items-center gap-2" href="${pageContext.request.contextPath}/vehicles?action=browse"><i class="bi bi-search text-slate-500"></i> Browse All</a></li>
        <li><a class="hover:text-brand-400 transition flex items-center gap-2" href="${pageContext.request.contextPath}/vehicles?action=browse&type=Car"><i class="bi bi-car-front text-slate-500"></i> Cars</a></li>
        <li><a class="hover:text-brand-400 transition flex items-center gap-2" href="${pageContext.request.contextPath}/vehicles?action=browse&type=Bike"><i class="bi bi-bicycle text-slate-500"></i> Bikes</a></li>
        <li><a class="hover:text-brand-400 transition flex items-center gap-2" href="${pageContext.request.contextPath}/vehicles?action=browse&type=Van"><i class="bi bi-truck text-slate-500"></i> Vans</a></li>
        <li><a class="hover:text-brand-400 transition flex items-center gap-2" href="${pageContext.request.contextPath}/vehicles?action=browse&availableOnly=1"><i class="bi bi-check-circle text-slate-500"></i> Available Now</a></li>
      </ul>
    </div>

    <!-- Admin -->
    <div>
      <h4 class="text-white font-bold mb-3 text-sm uppercase tracking-wider">Admin</h4>
      <ul class="space-y-2.5 text-sm">
        <li><a class="hover:text-brand-400 transition flex items-center gap-2" href="${pageContext.request.contextPath}/vehicles?action=dashboard"><i class="bi bi-speedometer2 text-slate-500"></i> Dashboard</a></li>
        <li><a class="hover:text-brand-400 transition flex items-center gap-2" href="${pageContext.request.contextPath}/vehicles?action=list"><i class="bi bi-table text-slate-500"></i> Manage Fleet</a></li>
        <li><a class="hover:text-brand-400 transition flex items-center gap-2" href="${pageContext.request.contextPath}/vehicles?action=add"><i class="bi bi-plus-lg text-slate-500"></i> Add Vehicle</a></li>
        <li><a class="hover:text-brand-400 transition flex items-center gap-2" href="${pageContext.request.contextPath}/auth?action=users"><i class="bi bi-people text-slate-500"></i> User Management</a></li>
      </ul>
    </div>

    <!-- Project Info -->
    <div>
      <h4 class="text-white font-bold mb-3 text-sm uppercase tracking-wider">Project</h4>
      <ul class="space-y-2 text-xs text-slate-400">
        <li class="flex items-center gap-1.5"><i class="bi bi-mortarboard text-slate-500"></i> SE1020 — OOP Assignment</li>
        <li class="flex items-center gap-1.5"><i class="bi bi-layers text-slate-500"></i> Component: Vehicle Management</li>
        <li class="flex items-center gap-1.5"><i class="bi bi-person-badge text-slate-500"></i> Sankalpa T.W.K.S.D</li>
        <li class="flex items-center gap-1.5"><i class="bi bi-hash text-slate-500"></i> IT22564290 · Member 22</li>
        <li class="mt-3 flex items-center gap-1.5">
          <i class="bi bi-github text-slate-500"></i>
          <a href="https://github.com/SachinthaDaham/Car-rental-Platform" class="hover:text-brand-400 transition" target="_blank">View on GitHub</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-slate-800 py-5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-500">
      <span>&copy; 2026 DriveLanka &mdash; Educational Project. All rights reserved.</span>
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
        Java 17 &middot; Tomcat 9 &middot; Tailwind CSS
      </span>
    </div>
  </div>
</footer>

</body>
</html>
