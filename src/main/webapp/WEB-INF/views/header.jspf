<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="com.vrp.model.User" %>
<%
    String ctx = request.getContextPath();
    String current = (String) request.getAttribute("nav");
    if (current == null) current = "";
com.vrp.model.User sessionUser = (com.vrp.model.User) session.getAttribute("loggedInUser");
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= request.getAttribute("pageTitle") == null ? "DriveLanka — Vehicle Rental" : request.getAttribute("pageTitle") %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="<%= ctx %>/css/style.css">
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: { 50:'#eef9ff',100:'#daf1ff',200:'#bae6fd',300:'#7dd3fc',400:'#38bdf8',500:'#0ea5e9',600:'#0284c7',700:'#0369a1',800:'#075985',900:'#0c4a6e' },
              ink:   { 900:'#0b1220',800:'#111827',700:'#1f2937' }
            },
            fontFamily: { sans:['Inter','system-ui','sans-serif'] },
            boxShadow: { card:'0 10px 30px -12px rgba(2,132,199,.25)', btn:'0 4px 14px rgba(2,132,199,.35)' }
          }
        }
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-50 text-ink-900 font-sans antialiased">

<!-- TOAST CONTAINER -->
<div id="toastContainer" class="fixed top-5 right-5 z-50 space-y-2 pointer-events-none"></div>

<!-- NAV -->
<header class="sticky top-0 z-30 backdrop-blur bg-white/90 border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">

    <!-- Logo -->
    <a href="<%= ctx %>/" class="flex items-center gap-2 shrink-0">
      <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-card">
        <i class="bi bi-car-front-fill text-lg"></i>
      </span>
      <span class="text-xl font-extrabold tracking-tight">Drive<span class="text-brand-600">Lanka</span></span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
      <a href="<%= ctx %>/" class="hover:text-brand-600 transition <%= "home".equals(current)?"text-brand-600 font-semibold":"" %>">Home</a>
      <a href="<%= ctx %>/vehicles?action=browse" class="hover:text-brand-600 transition <%= "browse".equals(current)?"text-brand-600 font-semibold":"" %>">Browse Fleet</a>
      <% if (sessionUser != null && sessionUser.isAdmin()) { %>
        <a href="<%= ctx %>/vehicles?action=dashboard" class="hover:text-brand-600 transition <%= "dashboard".equals(current)?"text-brand-600 font-semibold":"" %>">Dashboard</a>
        <a href="<%= ctx %>/vehicles?action=list"      class="hover:text-brand-600 transition <%= "list".equals(current)?"text-brand-600 font-semibold":"" %>">Fleet</a>
        <a href="<%= ctx %>/booking?action=adminList"  class="hover:text-brand-600 transition <%= "bookings".equals(current)?"text-brand-600 font-semibold":"" %>">Bookings</a>
        <a href="<%= ctx %>/chat?action=admin" class="relative hover:text-brand-600 transition <%= "chat".equals(current)?"text-brand-600 font-semibold":"" %>">
          Live Chat
          <span id="adminChatBadge" class="hidden absolute -top-1.5 -right-2.5 w-4 h-4 rounded-full bg-rose-500 text-white text-[9px] font-bold flex items-center justify-center"></span>
        </a>
      <% } else if (sessionUser != null) { %>
        <a href="<%= ctx %>/auth?action=dashboard" class="hover:text-brand-600 transition">My Account</a>
        <a href="<%= ctx %>/booking?action=my"     class="hover:text-brand-600 transition <%= "myBookings".equals(current)?"text-brand-600 font-semibold":"" %>">My Bookings</a>
      <% } %>
    </nav>

    <!-- Desktop right actions -->
    <div class="hidden md:flex items-center gap-2">
      <% if (sessionUser != null) { %>
        <span class="text-sm text-slate-500 font-medium">Hi, <strong><%= (sessionUser.getName() != null && !sessionUser.getName().isEmpty()) ? sessionUser.getName().split(" ")[0] : sessionUser.getUsername() %></strong></span>
        <% if (sessionUser.isAdmin()) { %>
          <a href="<%= ctx %>/vehicles?action=add" class="inline-flex items-center gap-1.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-4 py-2 rounded-lg shadow-btn transition">
            <i class="bi bi-plus-lg"></i> Add Vehicle
          </a>
        <% } %>
        <a href="<%= ctx %>/auth?action=logout" class="text-sm font-semibold text-rose-500 hover:text-rose-700 border border-rose-200 hover:border-rose-300 px-3 py-1.5 rounded-lg transition">Logout</a>
      <% } else { %>
        <a href="<%= ctx %>/auth?action=login"    class="text-sm font-semibold text-slate-600 hover:text-brand-600 px-3 py-1.5 transition">Sign In</a>
        <a href="<%= ctx %>/auth?action=register" class="inline-flex items-center gap-1 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-4 py-2 rounded-lg shadow-btn transition">
          <i class="bi bi-person-plus"></i> Register
        </a>
      <% } %>
    </div>

    <!-- Mobile hamburger -->
    <button id="menuBtn" class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg hover:bg-slate-100 transition text-slate-600" aria-label="Menu">
      <i class="bi bi-list text-2xl"></i>
    </button>
  </div>

  <!-- Mobile menu (hidden by default) -->
  <div id="mobileMenu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pb-4">
    <nav class="flex flex-col gap-1 mt-3 text-sm font-medium">
      <a href="<%= ctx %>/" class="px-3 py-2.5 rounded-lg hover:bg-slate-50 text-slate-700 flex items-center gap-2">
        <i class="bi bi-house"></i> Home
      </a>
      <a href="<%= ctx %>/vehicles?action=browse" class="px-3 py-2.5 rounded-lg hover:bg-slate-50 text-slate-700 flex items-center gap-2">
        <i class="bi bi-search"></i> Browse Fleet
      </a>
      <% if (sessionUser != null && sessionUser.isAdmin()) { %>
        <a href="<%= ctx %>/vehicles?action=dashboard" class="px-3 py-2.5 rounded-lg hover:bg-slate-50 text-slate-700 flex items-center gap-2"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a href="<%= ctx %>/vehicles?action=list"      class="px-3 py-2.5 rounded-lg hover:bg-slate-50 text-slate-700 flex items-center gap-2"><i class="bi bi-table"></i> Fleet</a>
        <a href="<%= ctx %>/booking?action=adminList"  class="px-3 py-2.5 rounded-lg hover:bg-slate-50 text-slate-700 flex items-center gap-2"><i class="bi bi-calendar-check"></i> Bookings</a>
        <a href="<%= ctx %>/chat?action=admin"         class="px-3 py-2.5 rounded-lg hover:bg-slate-50 text-slate-700 flex items-center gap-2"><i class="bi bi-chat-dots-fill text-brand-500"></i> Live Chat</a>
        <a href="<%= ctx %>/vehicles?action=add"       class="px-3 py-2.5 rounded-lg bg-brand-600 text-white flex items-center gap-2 mt-1"><i class="bi bi-plus-lg"></i> Add Vehicle</a>
      <% } else if (sessionUser != null) { %>
        <a href="<%= ctx %>/auth?action=dashboard" class="px-3 py-2.5 rounded-lg hover:bg-slate-50 text-slate-700 flex items-center gap-2"><i class="bi bi-person"></i> My Account</a>
        <a href="<%= ctx %>/booking?action=my"     class="px-3 py-2.5 rounded-lg hover:bg-slate-50 text-slate-700 flex items-center gap-2"><i class="bi bi-calendar-check"></i> My Bookings</a>
      <% } %>
      <div class="border-t border-slate-100 mt-2 pt-2">
        <% if (sessionUser != null) { %>
          <a href="<%= ctx %>/auth?action=logout" class="px-3 py-2.5 rounded-lg text-rose-500 flex items-center gap-2"><i class="bi bi-box-arrow-right"></i> Sign Out</a>
        <% } else { %>
          <a href="<%= ctx %>/auth?action=login"    class="px-3 py-2.5 rounded-lg hover:bg-slate-50 text-slate-700 flex items-center gap-2"><i class="bi bi-box-arrow-in-right"></i> Sign In</a>
          <a href="<%= ctx %>/auth?action=register" class="px-3 py-2.5 rounded-lg bg-brand-600 text-white flex items-center gap-2 mt-1"><i class="bi bi-person-plus"></i> Register</a>
        <% } %>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  document.getElementById('menuBtn').addEventListener('click', function() {
    var m = document.getElementById('mobileMenu');
    m.classList.toggle('hidden');
    this.querySelector('i').className = m.classList.contains('hidden') ? 'bi bi-list text-2xl' : 'bi bi-x-lg text-2xl';
  });

  // Toast system
  window.showToast = function(msg, type) {
    var colors = { success:'bg-emerald-500', error:'bg-rose-500', info:'bg-brand-600', warning:'bg-amber-500' };
    var t = document.createElement('div');
    t.className = 'pointer-events-auto flex items-center gap-3 ' + (colors[type]||colors.info) + ' text-white text-sm font-semibold px-4 py-3 rounded-xl shadow-lg translate-x-0 opacity-100 transition-all duration-300';
    t.innerHTML = '<i class="bi bi-' + (type==='success'?'check-circle':type==='error'?'x-circle':'info-circle') + '-fill"></i>' + msg;
    document.getElementById('toastContainer').appendChild(t);
    setTimeout(function() { t.style.opacity='0'; t.style.transform='translateX(100%)'; setTimeout(function(){t.remove();},300); }, 3000);
  };

  // Auto-show toast from URL ?msg=
  (function() {
    var u = new URLSearchParams(window.location.search);
    var m = u.get('msg');
    var toasts = {
      created:'Vehicle added successfully!', updated:'Vehicle updated!', deleted:'Vehicle deleted.', toggled:'Availability updated.',
      booking_created:'Booking confirmed! Proceed to payment.',
      booking_cancelled:'Booking cancelled.',
      payment_success:'Payment successful! Booking confirmed.',
      payment_failed:'Payment failed. Please try again.',
      profile_updated:'Profile updated successfully.',
      password_changed:'Password changed.',
      chat_sent:'Message sent to support.',
      status_updated:'Booking status updated.',
      user_deleted:'User removed.'
    };
    var types = {
      created:'success', updated:'success', deleted:'info', toggled:'info',
      booking_created:'success', booking_cancelled:'info', payment_success:'success', payment_failed:'error',
      profile_updated:'success', password_changed:'success', chat_sent:'info', status_updated:'success', user_deleted:'info'
    };
    if (m && toasts[m]) { setTimeout(function(){ window.showToast(toasts[m], types[m]||'info'); }, 300); }
  })();
</script>

<main>
