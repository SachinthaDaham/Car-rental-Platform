<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="com.vrp.model.User" %>
<%
    String ctx = request.getContextPath();
    String current = (String) request.getAttribute("nav");
    if (current == null) current = "";
    User sessionUser = (User) session.getAttribute("loggedInUser");
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= request.getAttribute("pageTitle") == null ? "DriveLanka — Vehicle Rental" : request.getAttribute("pageTitle") %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="<%= ctx %>/css/style.css">
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand:   { 50:'#eef9ff', 100:'#daf1ff', 500:'#0ea5e9', 600:'#0284c7', 700:'#0369a1', 900:'#0c4a6e' },
              ink:     { 900:'#0b1220', 800:'#111827', 700:'#1f2937' }
            },
            fontFamily: { sans: ['Inter','system-ui','sans-serif'] },
            boxShadow: { card: '0 10px 30px -12px rgba(2,132,199,.25)' }
          }
        }
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-50 text-ink-900 font-sans antialiased">

<header class="sticky top-0 z-30 backdrop-blur bg-white/80 border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
    <a href="<%= ctx %>/" class="flex items-center gap-2">
      <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-card">
        <i class="bi bi-car-front-fill text-lg"></i>
      </span>
      <span class="text-xl font-extrabold tracking-tight">Drive<span class="text-brand-600">Lanka</span></span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-700">
      <a href="<%= ctx %>/"                            class="hover:text-brand-600 <%= "home".equals(current)?"text-brand-600":"" %>">Home</a>
      <a href="<%= ctx %>/vehicles?action=browse"      class="hover:text-brand-600 <%= "browse".equals(current)?"text-brand-600":"" %>">Browse Fleet</a>
      <% if (sessionUser != null && sessionUser.isAdmin()) { %>
        <a href="<%= ctx %>/vehicles?action=dashboard"   class="hover:text-brand-600 <%= "dashboard".equals(current)?"text-brand-600":"" %>">Admin Dashboard</a>
        <a href="<%= ctx %>/vehicles?action=list"        class="hover:text-brand-600 <%= "list".equals(current)?"text-brand-600":"" %>">Manage Fleet</a>
      <% } else if (sessionUser != null) { %>
        <a href="<%= ctx %>/auth?action=dashboard"   class="hover:text-brand-600 <%= "dashboard".equals(current)?"text-brand-600":"" %>">My Dashboard</a>
      <% } %>
    </nav>
    <div class="flex items-center gap-3">
      <% if (sessionUser != null) { %>
        <% if (sessionUser.isAdmin()) { %>
          <a href="<%= ctx %>/vehicles?action=add" class="hidden sm:inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-4 py-2 rounded-lg shadow-card transition">
            <i class="bi bi-plus-lg"></i> Add Vehicle
          </a>
        <% } else { %>
            <div class="hidden sm:block text-sm font-semibold text-slate-600">Hi, <%= sessionUser.getName() %></div>
        <% } %>
        <a href="<%= ctx %>/auth?action=logout" class="text-sm font-semibold text-slate-500 hover:text-rose-600 transition">Logout</a>
      <% } else { %>
        <a href="<%= ctx %>/auth?action=login" class="text-sm font-semibold text-slate-600 hover:text-brand-600 transition">Sign In</a>
        <a href="<%= ctx %>/auth?action=register" class="bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-4 py-2 rounded-lg shadow-card transition">Register</a>
      <% } %>
    </div>
  </div>
</header>

<main>
